# Notebook から Jetson へ転送・build するときの SSH 接続先。
# config/vgl.env は scripts/vgl.sh が対話入力して保存する（Git 管理外）。
# SSH key / password はここに書かず、通常の ~/.ssh/config 等で管理する。
ATD_VGL_SSH_TARGET=jetson
ATD_VGL_SSH_PORT=22
ATD_VGL_REMOTE_PROJECT=/home/jetson/workspaces/atd
ATD_VGL_REMOTE_RESULT_DIR=/home/jetson/workspaces/atd/data/results
