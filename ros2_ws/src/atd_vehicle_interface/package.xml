<?xml version="1.0"?>
<package format="3">
  <name>atd_vehicle_interface</name><version>0.1.0</version>
  <description>Receive JPBB Rev6 Pico telemetry and RC channels without driving outputs.</description>
  <maintainer email="carbuncle01@users.noreply.github.com">carbuncle01</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <depend>atd_interfaces</depend><depend>rclcpp</depend>
  <depend>rclcpp_components</depend><depend>rcl_interfaces</depend>
  <depend>std_msgs</depend><depend>yaml-cpp</depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
