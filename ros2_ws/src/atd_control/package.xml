<?xml version="1.0"?>
<package format="3">
  <name>atd_control</name>
  <version>0.1.0</version>
  <description>Lateral and longitudinal control observations for the ATD vehicle.</description>
  <maintainer email="carbuncle01@users.noreply.github.com">carbuncle01</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>atd_interfaces</exec_depend>
  <exec_depend>atd_planning</exec_depend>
  <exec_depend>atd_mapping</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
