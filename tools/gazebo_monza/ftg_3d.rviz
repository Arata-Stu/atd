Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Enabled: true
  Global Options:
    Fixed Frame: gazebo_world
    Background Color: 35; 38; 41
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 0.25
      Plane Cell Count: 100
      Alpha: 0.28
    - Class: rviz_default_plugins/MarkerArray
      Name: FTG vehicle, obstacles and paths
      Enabled: true
      Topic:
        Value: /atd/gazebo/ftg/markers
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Image
      Name: Depth (Turbo inverse depth)
      Enabled: true
      Topic:
        Value: /atd/gazebo/ftg/depth_heatmap
        Depth: 1
        Reliability Policy: Best Effort
        Durability Policy: Volatile
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: base_link
      Distance: 2.8
      Pitch: 0.83
      Yaw: 3.14
      Focal Point:
        X: 0.35
        Y: 0
        Z: 0
Window Geometry:
  Width: 1100
  Height: 760
