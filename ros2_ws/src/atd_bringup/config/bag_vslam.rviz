Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 35; 38; 41
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 100
      Alpha: 0.2
    - Class: rviz_default_plugins/PointCloud2
      Name: cuVSLAM landmarks
      Enabled: true
      Topic:
        Value: /visual_slam/vis/landmarks_cloud
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 118; 215; 170
    - Class: rviz_default_plugins/PointCloud2
      Name: Loop closure landmarks
      Enabled: true
      Topic:
        Value: /visual_slam/vis/loop_closure_cloud
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 5
      Color Transformer: FlatColor
      Color: 255; 100; 218
    - Class: rviz_default_plugins/Odometry
      Name: SLAM odometry (recent)
      Enabled: true
      Topic:
        Value: /visual_slam/vis/slam_odometry
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Keep: 20
      Position Tolerance: 0.0
      Angle Tolerance: 0.0
      Shape:
        Value: Arrow
        Color: 255; 180; 65
        Shaft Length: 0.32
        Shaft Radius: 0.055
        Head Length: 0.18
        Head Radius: 0.14
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Path
      Name: Gazebo ground truth
      Enabled: true
      Topic:
        Value: /atd/replay/ground_truth_path
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Line Style: Billboards
      Line Width: 0.15
      Alpha: 0.65
      Color: 60; 175; 255
    - Class: rviz_default_plugins/Marker
      Name: Position error at latest estimate
      Enabled: true
      Topic:
        Value: /atd/replay/position_error
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Image
      Name: Left IR
      Enabled: true
      Topic:
        Value: /camera/camera/infra1/image_rect_raw
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Image
      Name: Right IR
      Enabled: true
      Topic:
        Value: /camera/camera/infra2/image_rect_raw
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Target Frame: <Fixed Frame>
      Scale: 12
      X: 0
      Y: 0
