<?xml version="1.0"?>
<package format="3">
  <name>atd_bringup</name><version>0.1.0</version>
  <description>Jetson vehicle and Notebook Gazebo ROS bringup.</description>
  <maintainer email="carbuncle01@users.noreply.github.com">carbuncle01</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>atd_sensors</exec_depend><exec_depend>atd_vehicle_description</exec_depend>
  <exec_depend>atd_web_bridge</exec_depend><exec_depend>atd_joy</exec_depend>
  <exec_depend>atd_teleop</exec_depend><exec_depend>atd_vehicle_interface</exec_depend>
  <exec_depend>atd_rc_input</exec_depend>
  <exec_depend>atd_esc_trials</exec_depend>
  <exec_depend>atd_localization</exec_depend>
  <exec_depend>atd_planning</exec_depend>
  <exec_depend>atd_control</exec_depend>
  <exec_depend>atd_recording</exec_depend>
  <exec_depend>atd_mapping</exec_depend><exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_interfaces</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- GUI for the Notebook replay executable. The ATD image provisions it only on amd64. -->
  <exec_depend>rviz2</exec_depend><exec_depend>rviz_default_plugins</exec_depend>
  <exec_depend>isaac_ros_cuvslam</exec_depend><exec_depend>rclcpp_components</exec_depend>
  <exec_depend>isaac_ros_visual_slam_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend><test_depend>ament_cmake_pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
