Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 35; 38; 41
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 100
      Alpha: 0.15
    - Class: rviz_default_plugins/Path
      Name: Reference line
      Enabled: true
      Topic:
        Value: /atd/gazebo/reference_path
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 0.24
      Color: 130; 216; 158
    - Class: rviz_default_plugins/Path
      Name: Gazebo GT
      Enabled: true
      Topic:
        Value: /atd/gazebo/ground_truth_path
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 0.14
      Color: 60; 175; 255
      Offset: {X: 0, Y: 0, Z: 0.015}
    - Class: rviz_default_plugins/Path
      Name: Localized trajectory
      Enabled: true
      Topic:
        Value: /atd/gazebo/estimated_path
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 0.065
      Color: 255; 170; 65
      Offset: {X: 0, Y: 0, Z: 0.03}
    - Class: rviz_default_plugins/MarkerArray
      Name: Current poses (GT and estimate)
      Enabled: true
      Topic:
        Value: /atd/gazebo/current_poses
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Target Frame: <Fixed Frame>
      Scale: 16
      X: 0
      Y: 0
Window Geometry:
  Width: 1100
  Height: 760
