#!/usr/bin/env python3
"""閉ループ走行の正解姿勢と車体外形を RViz・Web の観測用に配信する。"""
import json
import math

import rclpy
from atd_bringup.gazebo_closed_loop_paths import ClosedLoopPaths, lookahead_remaining_ns
from atd_interfaces.msg import ControlStatus, LocalizationStatus
from atd_localization.assets import map_metadata, verified_hdmap
from atd_planning.core import ReferenceLine, yaw_from_quaternion
from geometry_msgs.msg import Point, PoseStamped
from nav_msgs.msg import Path
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy, qos_profile_sensor_data
from std_msgs.msg import Header, String
from visualization_msgs.msg import Marker, MarkerArray


def map_pose(stamp, position, orientation):
    """上面図に投影する。推定の高さの変動で太い参照線に隠れるのを防ぐ。"""
    pose = PoseStamped()
    pose.header.frame_id = 'map'
    pose.header.stamp.sec, pose.header.stamp.nanosec = divmod(stamp, 1_000_000_000)
    p, q = pose.pose.position, pose.pose.orientation
    p.x, p.y = float(position[0]), float(position[1])
    yaw = yaw_from_quaternion(*orientation)
    q.z, q.w = math.sin(yaw / 2), math.cos(yaw / 2)
    return pose


def arrow(name, pose, length, width, lift, color):
    marker = Marker(ns=name, id=0, type=Marker.ARROW)
    marker.header.frame_id = 'map'
    if pose is None:
        marker.action = Marker.DELETE
    else:
        marker.header = pose.header
        marker.pose.orientation = pose.pose.orientation
        p = pose.pose.position
        marker.pose.position = Point(x=p.x, y=p.y, z=p.z + lift)
        marker.scale.x, marker.scale.y, marker.scale.z = length, width, width
        marker.color.r, marker.color.g, marker.color.b, marker.color.a = (*color, 1.)
    return marker


def footprint_marker(pose, dimensions):
    marker = Marker(ns='Gazebo GT footprint', id=0, type=Marker.LINE_STRIP)
    marker.header.frame_id = 'map'
    if pose is None or not dimensions:
        marker.action = Marker.DELETE
        return marker
    rear = dimensions['rear_axle_to_rear']
    margin = dimensions['margin']
    front = dimensions['vehicle_length'] - rear + margin
    back = -rear - margin
    half = dimensions['vehicle_width'] / 2 + margin
    marker.header, marker.pose = pose.header, pose.pose
    marker.points = [Point(x=x, y=y, z=.14) for x, y in (
        (back, -half), (front, -half), (front, half), (back, half), (back, -half))]
    marker.scale.x = .025
    marker.color.r, marker.color.g, marker.color.b, marker.color.a = (.1, .95, 1., 1.)
    return marker


def lookahead_markers(msg, remaining_ns):
    target = Marker(ns='Pure Pursuit', id=0, type=Marker.SPHERE)
    link = Marker(ns='Pure Pursuit', id=1, type=Marker.LINE_STRIP)
    markers = MarkerArray(markers=[target, link])
    if not remaining_ns:
        for marker in markers.markers:
            marker.header.frame_id = 'map'
            marker.action = Marker.DELETE
        return markers
    for marker in markers.markers:
        marker.header = msg.header
        marker.pose.orientation.w = 1.
        marker.color.r, marker.color.g, marker.color.b, marker.color.a = (.77, .30, 1., 1.)
        marker.lifetime.sec, marker.lifetime.nanosec = divmod(remaining_ns, 1_000_000_000)
    # 走行ライン・姿勢矢印より上に置く。XY は操舵計算が使った map 座標のまま描く。
    p = msg.pose.position
    target.pose.position = Point(x=msg.target.x, y=msg.target.y, z=.35)
    target.scale.x = target.scale.y = target.scale.z = .30
    link.scale.x = .06
    link.points = [Point(x=p.x, y=p.y, z=.35), target.pose.position]
    return markers


class ClosedLoopViewer(Node):
    def __init__(self):
        super().__init__('atd_gazebo_closed_loop_paths')
        root = self.declare_parameter('results_root', '/data/results').value
        map_id = self.declare_parameter('map_id', '').value
        selection = self.declare_parameter('line', 'raceline').value
        rviz = self.declare_parameter('rviz', True).value
        stream = self.declare_parameter('gt_stream_id', '').value
        self.footprint = json.loads(self.declare_parameter('footprint_json', 'null').value)
        metadata = map_metadata(root, map_id)
        identity = {key: metadata[key] for key in ('map_id', 'map_sha256', 'hdmap_sha256')}
        self.paths = ClosedLoopPaths(tuple(identity.values()), map_pose, history_size=8192 if rviz else 0)
        self.create_subscription(PoseStamped, '/atd/gazebo/ground_truth_pose', self.world_pose, qos_profile_sensor_data)
        self.create_subscription(LocalizationStatus, '/localization/status',
                                 self.localization if rviz else self.paths.localization, 10)
        if stream and self.footprint:
            self.live_metadata = dict(identity, stream_id=stream, footprint=self.footprint)
            self.last_live_pose = None
            self.live_gt = self.create_publisher(String, '/atd/gazebo/aligned_ground_truth', qos_profile_sensor_data)
            self.create_timer(.1, self.publish_live)
        if not rviz:
            return
        document = json.loads(verified_hdmap(root, metadata))
        line = ReferenceLine.from_document(document, selection)
        self.last_arrows = (None, None)
        qos = QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL, reliability=ReliabilityPolicy.RELIABLE)
        self.reference = self.create_publisher(Path, '/atd/gazebo/reference_path', qos)
        self.gt = self.create_publisher(Path, '/atd/gazebo/ground_truth_path', qos)
        self.estimate = self.create_publisher(Path, '/atd/gazebo/estimated_path', qos)
        self.markers = self.create_publisher(MarkerArray, '/atd/gazebo/current_poses', qos)
        self.selection = selection
        self.pursuit_sample = self.drawn_pursuit = None
        self.lookahead = self.create_publisher(MarkerArray, '/atd/gazebo/lookahead_markers', 1)
        self.create_subscription(ControlStatus, '/atd/gazebo/pursuit_status', self.pursuit, 1)
        points, _ = line.preview(0., line.length)
        self.reference.publish(Path(header=Header(frame_id='map'), poses=[
            map_pose(0, (x, y, 0.), (0., 0., 0., 1.)) for x, y in points]))
        self.create_timer(.2, self.publish)

    def world_pose(self, msg):
        try:
            self.paths.world_pose(msg)
        except ValueError as exc:
            self.get_logger().warning(str(exc), throttle_duration_sec=5.)

    def localization(self, msg):
        self.paths.localization(msg)
        if self.paths.segment is None:
            self.pursuit_sample = None
        self.publish_lookahead()

    def pursuit(self, msg):
        self.pursuit_sample = msg if msg.valid else None
        self.publish_lookahead()

    def publish_lookahead(self):
        ns = lookahead_remaining_ns(self.pursuit_sample, self.get_clock().now().nanoseconds,
                                    self.paths.identity, self.selection, self.paths.segment)
        sample = self.pursuit_sample if ns else None
        if sample is not self.drawn_pursuit:
            self.lookahead.publish(lookahead_markers(sample, ns))
            self.drawn_pursuit = sample

    def publish_live(self):
        sample = self.paths.gt.current
        if sample is None or sample is self.last_live_pose:
            return
        self.last_live_pose = sample
        p, q, stamp = sample.pose.position, sample.pose.orientation, sample.header.stamp
        row = dict(self.live_metadata, frame=sample.header.frame_id, stamp_s=stamp.sec + stamp.nanosec * 1e-9,
                   x=p.x, y=p.y, yaw=yaw_from_quaternion(q.x, q.y, q.z, q.w))
        self.live_gt.publish(String(data=json.dumps(row, allow_nan=False)))

    def publish(self):
        self.publish_lookahead()
        header = Header(frame_id='map', stamp=self.get_clock().now().to_msg())
        for history, publisher in ((self.paths.gt, self.gt), (self.paths.estimate, self.estimate)):
            if history.changed:
                publisher.publish(Path(header=header, poses=list(history.points)))
                history.changed = False
        poses = (self.paths.gt.current, self.paths.estimate.current)
        if poses != self.last_arrows:
            self.markers.publish(MarkerArray(markers=[
                arrow('Gazebo GT', poses[0], .8, .18, .10, (.24, .69, 1.)),
                arrow('Localization', poses[1], .55, .12, .25, (1., .55, .12)),
                footprint_marker(poses[0], self.footprint),
            ]))
            self.last_arrows = poses


def main():
    rclpy.init()
    try:
        node = ClosedLoopViewer()
        try:
            rclpy.spin(node)
        except (KeyboardInterrupt, ExternalShutdownException):
            pass
        finally:
            node.destroy_node()
    finally:
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
