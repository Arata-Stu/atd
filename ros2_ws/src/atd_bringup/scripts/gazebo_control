#!/usr/bin/env python3
"""保存地図に追跡中の仮想車両に Pure Pursuit と FF＋PID の出力を渡す。"""
from dataclasses import asdict
from functools import partial
import json

import rclpy
from rcl_interfaces.msg import SetParametersResult
from atd_interfaces.msg import ControlStatus, LocalizationStatus, PlanningStatus
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile
from sensor_msgs.msg import JointState
from std_msgs.msg import String

from atd_bringup.gazebo_control import GazeboController, default_min_lookahead, simulation_table
from atd_control.bicycle import WHEELBASE_M, resolve_full_throttle_speed
from atd_control.core import LookaheadConfig, unavailable
from atd_control.monitor import pursuit_status
from atd_control.speed import PIDConfig


class GazeboControlNode(Node):
    def __init__(self, **kwargs):
        super().__init__('atd_gazebo_control', **kwargs)
        if not self.get_parameter('use_sim_time').value:
            raise ValueError('Gazebo の /clock が必要です')
        route = tuple(self.declare_parameter(k, '').value for k in ('map_id', 'map_sha256', 'hdmap_sha256'))
        line = self.declare_parameter('line', 'raceline').value
        speed = self.declare_parameter('max_speed_mps', 1.5).value
        full_speed = self.declare_parameter('full_throttle_speed_mps', resolve_full_throttle_speed(speed)).value
        table = simulation_table(self.declare_parameter('feedforward_path', '').value, full_speed)
        defaults = LookaheadConfig(min_lookahead_m=default_min_lookahead(line))
        lookahead = {k: self.declare_parameter(k, v).value for k, v in asdict(defaults).items()}
        pid = {k: self.declare_parameter('speed_' + k, v).value for k, v in asdict(PIDConfig()).items()}
        self.controller = GazeboController(route, line, speed, table, full_throttle_speed_mps=full_speed,
                                          lookahead=LookaheadConfig(**lookahead), pid=PIDConfig(**pid))
        self.actuators = self.create_publisher(JointState, '/atd/gazebo/actuators', 1)
        status_qos = QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL)
        self.status = self.create_publisher(String, '/atd/gazebo/control_state', status_qos)
        self.pursuit = self.create_publisher(ControlStatus, '/atd/gazebo/pursuit_status', 1)
        self.last_status = None
        self.last_report_ns = 0
        self.observers = [
            self.create_subscription(LocalizationStatus, '/localization/status', partial(self.observe, 'localization'), 10),
            self.create_subscription(PlanningStatus, '/planning/status', partial(self.observe, 'planning'), 10),
        ]
        self.create_timer(.05, self.watch)
        self.add_on_set_parameters_callback(self.validate_tuning)
        self.add_post_set_parameters_callback(self.apply_tuning)

    def validate_tuning(self, params):
        try:
            self.controller.tuning({p.name: p.value for p in params})
        except (TypeError, ValueError) as exc:
            return SetParametersResult(successful=False, reason=str(exc))
        return SetParametersResult(successful=True)

    def apply_tuning(self, params):
        updates = {p.name: p.value for p in params}
        if self.controller.apply_tuning(updates):
            self.get_logger().info(f'Gazebo 制御設定を適用 sim_time_ns={self.get_clock().now().nanoseconds} '
                                   f'{json.dumps(updates, sort_keys=True)}')

    def check_sources(self):
        return self.controller.check_sources(*(sub.get_publisher_count() for sub in self.observers))

    def observe(self, kind, msg):
        now = self.get_clock().now().nanoseconds
        self.publish(now, self.controller.observe(kind, msg, now) if self.check_sources() else None)

    def watch(self):
        now = self.get_clock().now().nanoseconds
        self.publish(now, self.controller.ready(now) if self.check_sources() else None)

    def publish(self, now, drive):
        controller = self.controller
        # During an observation gap the Gazebo plant expires the previous command
        # to neutral. An explicit disable after launch is a latched fault.
        if drive is not None or controller.state in ('waiting', 'stopped'):
            message = JointState()
            ns, steer, throttle = (now, 0., 0.) if drive is None else drive
            message.header.stamp.sec, message.header.stamp.nanosec = divmod(ns, 1_000_000_000)
            message.header.frame_id = 'base_link'
            message.name = ['steering', 'throttle', 'enable']
            message.position = [steer, throttle, float(drive is not None)]
            self.actuators.publish(message)
        status = (controller.state, controller.reason)
        heartbeat = controller.state != 'driving' and now - self.last_report_ns >= 1_000_000_000
        if status != self.last_status or drive is not None or heartbeat:
            self.last_report_ns = now
            if status != self.last_status:
                self.last_status = status
                detail = ''
                if drive is not None:
                    detail = (f' map={controller.route[0]} line={controller.line} '
                              f'session={controller.session[3]} epoch={controller.session[4]} '
                              f'image_stamp_ns={drive[0]} command_sim_ns={now}')
                self.get_logger().info(f'{status[0]} {status[1]}{detail}')
            report = dict(state=status[0], reason=status[1], stamp_ns=now, map_id=controller.route[0],
                          line=controller.line)
            if drive is not None:
                report.update(controller.observation, steering_rad=drive[1], throttle=drive[2])
            self.status.publish(String(data=json.dumps(report, ensure_ascii=False, allow_nan=False)))
            if self.pursuit.get_subscription_count():
                if drive is None:
                    msg = pursuit_status(None, unavailable(controller.reason), controller.lookahead, WHEELBASE_M)
                else:
                    plan, pose, steering = controller.pursuit_sample
                    msg = pursuit_status(plan, steering, controller.lookahead, WHEELBASE_M, pose=pose,
                                         validity_limit=(controller.expires - controller.stamp) * 1e-9)
                self.pursuit.publish(msg)


def main():
    rclpy.init()
    try:
        node = GazeboControlNode()
        try:
            rclpy.spin(node)
        except KeyboardInterrupt:
            pass
        finally:
            node.destroy_node()
    finally:
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
