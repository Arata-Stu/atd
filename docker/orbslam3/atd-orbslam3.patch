+void LoopClosing::JoinGlobalBA(bool cancel)
+{
+    if (!mpThreadGBA) return;
+    if (cancel) {
+        unique_lock<mutex> lock(mMutexGBA);
+        mbStopGBA = true;
+        ++mnFullBAIdx;
+    }
+    mpThreadGBA->join();
+    delete mpThreadGBA;
+    mpThreadGBA = nullptr;
+    unique_lock<mutex> lock(mMutexGBA);
+    mbRunningGBA = false;
+    mbFinishedGBA = true;
