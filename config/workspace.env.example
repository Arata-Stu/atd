# ホストごとに ROS workspace を指定する（未設定時は <clone先>/ros2_ws）。
# setup.sh --action workspace が選択したホストの値だけを保存する。
# config/workspace.env に保存され、Git の管理対象にはしない。
# 空白や shell 特殊文字を含むパスは公式 CLI の制約により使用できない。
# 標準の clone 先は ~/workspaces/atd。別の場所に clone した場合も、その ros2_ws を使う。
# ATD_PC_ROS_WS=/home/user/workspaces/atd/ros2_ws
# ATD_JETSON_ROS_WS=/home/jetson/workspaces/atd/ros2_ws
