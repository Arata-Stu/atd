#!/usr/bin/env bash
# ホストとコンテナで共有する日常操作の入口。
set -euo pipefail

launcher="${BASH_SOURCE[0]}"
while [[ -L "$launcher" ]]; do
    target="$(readlink "$launcher")"
    if [[ "$target" = /* ]]; then launcher="$target"; else launcher="$(dirname -- "$launcher")/$target"; fi
done
scripts_dir="$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)"
source "$scripts_dir/lib/detect_host.sh"

host="$(detect_atd_host)"
if atd_in_container; then location=Docker; else location=ホスト; fi
if [[ "$host" = jetson ]]; then device=Jetson; else device=Notebook; fi

commands=()
paths=()
labels=()
host_ssh=lib/jetson_host_ssh.sh
add_command() {
    commands+=("$1")
    if [[ "${4:-}" = host-control && "$location" = Docker ]]; then
        paths+=("$host_ssh")
        labels+=("$3（Jetson ホストへ SSH）")
    else
        paths+=("$2")
        labels+=("$3")
    fi
}

if [[ "$location" = ホスト ]]; then
    add_command dev dev.sh '開発コンテナに入る'
fi
add_command build build.sh 'ROS パッケージをビルド'
if [[ "$host" = jetson ]]; then
    add_command bringup bringup.sh '車両の起動構成を選ぶ'
    add_command bluetooth bluetooth.sh 'DualSense の接続・状態確認' host-control
    add_command hotspot hotspot.sh 'Wi-Fi アクセスポイントの起動・帯域切替・停止' host-control
    add_command display jetson_display_mode.sh 'GUI / CUI 起動モードを設定' host-control
    add_command performance jetson_max_performance.sh '最大クロック・ファンの確認と適用' host-control
elif [[ "$location" = ホスト || "$(uname -m)" = x86_64 ]]; then
    add_command web webui.sh 'Notebook の Web UI を起動・準備'
    if [[ "$(uname -s)/$(uname -m)" = Linux/x86_64 ]]; then
        add_command bringup bringup.sh 'Gazebo の時計とステレオ画像で Visual Odometry を起動'
        add_command replay replay.sh 'ステレオ rosbag を再生し cuVSLAM を RViz で表示'
        if [[ "$location" = ホスト ]]; then
            add_command gazebo gazebo.sh 'サーキットの周回・rosbag 記録・ステレオ動画・受信計測'
        fi
    fi
fi
add_command python tools/python.sh 'Python 環境を選ぶ'
if [[ "$location" = ホスト ]]; then
    add_command vgl vgl.sh 'VGL モデルを準備・転送'
    add_command setup setup.sh 'ホストのセットアップ'
    add_command docker tools/docker.sh 'Docker 環境を診断'
    add_command cache tools/clean-docker-cache.sh 'Docker キャッシュの確認・整理'
fi

# 直接実行と TUI で同じ起動先を解決する。
resolve_command() {
    local index
    for index in "${!commands[@]}"; do
        if [[ "${commands[index]}" = "$1" ]]; then
            runner=("$scripts_dir/${paths[index]}")
            if [[ "${paths[index]}" = "$host_ssh" ]]; then runner+=("$1"); fi
            return 0
        fi
    done
    return 1
}

usage() {
    cat <<'EOF'
使い方: atd                       日常操作のメニューを開く
        atd --list                この環境で使えるコマンドを表示
        atd COMMAND [引数...]     選択したスクリプトを直接実行

例: atd build --packages-up-to atd_bringup
    atd bluetooth status
    atd hotspot on --band 5
    atd web prepare
    atd gazebo
    atd gazebo bag --course odaiba --speed 3 --laps 2
    atd gazebo video --route lap
    atd gazebo serve
    atd bringup gazebo
    atd replay
各コマンドの使い方は atd COMMAND --help で確認できます。
EOF
}

# key、表示名の組を受け取り、選択した key だけを標準出力に返す。
choose() {
    local title="$1" line entry reply index
    local -a entries=()
    shift
    while (($#)); do
        entries+=("$1"$'\t'"$2")
        shift 2
    done
    if command -v fzf >/dev/null 2>&1; then
        line="$(printf '%s\n' "${entries[@]}" | fzf --height=70% --layout=reverse --border \
            --delimiter=$'\t' --prompt="$title > " --header='入力で検索 / ↑↓ で選択 / Enter で決定 / Esc で戻る')" || return 1
        for entry in "${entries[@]}"; do
            if [[ "$line" = "$entry" ]]; then
                printf '%s\n' "${entry%%$'\t'*}"
                return
            fi
        done
        printf 'fzf で候補を一つ選んでください。\n' >&2
        return 1
    fi
    printf '\n%s\n' "$title" >&2
    for index in "${!entries[@]}"; do
        printf '  %2d) %s\n' "$((index + 1))" "${entries[index]}" >&2
    done
    while true; do
        printf '番号を選択（空 Enter で戻る）> ' >&2
        IFS= read -r reply || return 1
        [[ -n "$reply" ]] || return 1
        for index in "${!entries[@]}"; do
            if [[ "$reply" = "$((index + 1))" ]]; then
                printf '%s\n' "${entries[index]%%$'\t'*}"
                return
            fi
        done
        printf '表示された番号を入力してください。\n' >&2
    done
}

gazebo_from_menu() {
    local title="$1" action catalog circuit speed laps resolution camera_hz imu
    shift
    action="$(choose "$title" bag 'ステレオ rosbag を記録' map '走行中に cuVSLAM 地図を作成' \
        video '左右の車載動画を保存' serve 'ステレオ画像と /clock を配信' \
        run '動画を保存し、別の試行で受信速度を測定' benchmark 'ステレオの配信レートを測定' \
        diagnose 'Gazebo と ROS の画像受信を比較' prepare '専用イメージを準備・容量を測定' \
        back '前のメニューへ')" || return 0
    case "$action" in
        back) return 0 ;;
        prepare) "$@" prepare; return ;;
    esac
    catalog="$("$@" list)" || return
    local -a options=()
    while IFS= read -r circuit; do
        case "$circuit" in
            '') ;;
            odaiba) options+=("$circuit" 'お台場・シティサーキット東京ベイ（1/5）') ;;
            *) options+=("$circuit" "$circuit") ;;
        esac
    done <<< "$catalog"
    circuit="$(choose "$title / コース" "${options[@]}" back '前のメニューへ')" || return 0
    [[ "$circuit" != back ]] || return 0
    local -a args=("$action" --route lap --circuit "$circuit")
    printf '走行速度 [RC m/s]（Enter でコース既定、q で戻る）> ' >&2
    IFS= read -r speed || return 0
    [[ "$speed" != q ]] || return 0
    if [[ -n "$speed" ]]; then args+=(--speed "$speed"); fi
    if [[ "$action" != benchmark && "$action" != diagnose ]]; then
        local default_laps='1周'
        if [[ "$action" = serve ]]; then default_laps='連続配信'; fi
        printf '周回数（Enter で%s、q で戻る）> ' "$default_laps" >&2
        IFS= read -r laps || return 0
        [[ "$laps" != q ]] || return 0
        if [[ -n "$laps" ]]; then args+=(--laps "$laps"); fi
    fi
    resolution="$(choose "$title / ステレオ解像度" 640x480 '既定' 424x240 '' 848x480 '' 1280x720 '')" || return 0
    camera_hz="$(choose "$title / カメラの撮影レート" 90 'Hz（既定）' 60 'Hz' 30 'Hz')" || return 0
    imu="$(choose "$title / IMU" off 'ステレオのみ' 400 '加速度 200 Hz・ジャイロと統合 IMU 400 Hz' \
        200 '加速度・ジャイロ・統合 IMU 200 Hz')" || return 0
    "$@" "${args[@]}" --resolution "$resolution" --camera-hz "$camera_hz" --imu "$imu"
}

run_from_menu() {
    local key="$1" title="$device $location / $1" action manifest package
    shift
    local -a options=()
    case "$key" in
        build)
            options=(all 'ワークスペース全体')
            for manifest in "$scripts_dir"/../ros2_ws/src/atd_*/package.xml; do
                [[ -f "$manifest" ]] || continue
                package="${manifest%/package.xml}"
                package="${package##*/}"
                options+=("$package" 'このパッケージと依存先まで')
            done ;;
        bluetooth)
            options=(connect 'DualSense を接続' status '接続状態を表示') ;;
        hotspot)
            options=(status '接続状態を表示' on '保存済み設定で起動' 2.4 '2.4 GHz で起動・切替'
                     5 '5 GHz で起動・切替' off 'アクセスポイントを停止') ;;
        web)
            options=(serve 'Web UI を起動' prepare '初回・更新時のオンライン準備' check '準備状態を確認') ;;
        gazebo) gazebo_from_menu "$title" "$@"; return ;;
        replay)
            title="$title / 追跡方式"
            options=(vo 'VO（左右画像）' vio 'VIO（左右画像＋統合 IMU）') ;;
        display)
            options=(status '現在の設定を表示' cui '次回起動を CUI に設定' gui '次回起動を GUI に設定') ;;
        performance)
            options=(check 'クロックとファンを確認' apply '最大クロック・最大ファンを適用') ;;
        cache)
            options=(inspect '使用量と削除候補を確認' prune '未使用のビルドキャッシュを整理（確認あり）') ;;
        *) "$@"; return ;;
    esac
    action="$(choose "$title" "${options[@]}" back '前のメニューへ')" || return 0
    [[ "$action" != back ]] || return 0
    case "$key/$action" in
        build/all|performance/apply|cache/prune) "$@" ;;
        build/*) "$@" --packages-up-to "$action" ;;
        replay/*) "$@" --tracking "$action" ;;
        hotspot/2.4|hotspot/5) "$@" on --band "$action" ;;
        performance/check) "$@" --check ;;
        cache/inspect) "$@" --dry-run ;;
        *) "$@" "$action" ;;
    esac
}

if (($#)); then
    case "$1" in
        --help|-h) usage; exit 0 ;;
        --list)
            for i in "${!commands[@]}"; do printf '%s\t%s\n' "${commands[i]}" "${labels[i]}"; done
            exit 0 ;;
    esac
    if resolve_command "$1"; then
        if [[ ( "$1" = gazebo || "$1" = replay ) && $# = 1 && -t 0 && -t 1 ]]; then
            run_from_menu "$1" "${runner[@]}"
            exit
        fi
        shift
        exec "${runner[@]}" "$@"
    fi
    printf 'atd: %s %s で選べないコマンドです: %s（atd --list で一覧）\n' "$device" "$location" "$1" >&2
    exit 2
fi

if [[ ! -t 0 || ! -t 1 ]]; then usage >&2; exit 2; fi
menu=()
for i in "${!commands[@]}"; do menu+=("${commands[i]}" "${labels[i]}"); done
while selected="$(choose "ATD / $device $location" "${menu[@]}" quit '終了')"; do
    [[ "$selected" != quit ]] || break
    if resolve_command "$selected"; then
        run_from_menu "$selected" "${runner[@]}" ||
            printf 'atd: %s は終了コード %d で終了しました。\n' "$selected" "$?" >&2
    fi
done
