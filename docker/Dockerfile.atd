# ATD 固有の依存を追加する層。isaac_ros → realsense455 → atd の順に構築する。
# CLI が前の層のイメージを BASE_IMAGE として渡す。
ARG BASE_IMAGE
FROM node:24.22.3-bookworm-slim AS atd_web_node
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG DEBIAN_FRONTEND=noninteractive

# 公式 multi-arch バイナリを固定版で導入。system Python の pip は変更しない。
COPY --from=ghcr.io/astral-sh/uv:0.13.8 /uv /uvx /usr/local/bin/

# 共通 apt パッケージはイメージに導入する。起動 hook は導入状態を検査する。
COPY dependencies.apt /opt/atd/dependencies.apt
COPY scripts/install-dependencies.sh /opt/atd/scripts/install-dependencies.sh
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    bash /opt/atd/scripts/install-dependencies.sh --install \
    && test "$(uv --version | awk '{print $2}')" = 0.13.8 \
    && rm -rf /var/lib/apt/lists/*

# Notebook のみが UI を提供する。Jetson の最終 image に Node / pnpm を入れない。
# 公式 Debian/glibc binary を使い、Ubuntu apt の古い Node と Vite の要件を混在させない。
RUN --mount=type=bind,from=atd_web_node,source=/usr/local,target=/mnt/atd-node,ro \
    if [ "$(dpkg --print-architecture)" = amd64 ]; then \
        install -m 0755 /mnt/atd-node/bin/node /usr/local/bin/node; \
        mkdir -p /usr/local/lib/node_modules; \
        cp -a /mnt/atd-node/lib/node_modules/npm /usr/local/lib/node_modules/; \
        ln -sfn ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm; \
        ln -sfn ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx; \
        npm install --global --ignore-scripts pnpm@11.25.0; \
    fi

# checkout をマウントせずに使う場合は、ビルド時のスクリプト・設定を使う。
COPY Dockerfile.atd /opt/atd/Dockerfile.atd
COPY scripts/ /opt/atd/scripts/
COPY middleware_profiles/fastdds.xml /opt/atd/middleware_profiles/fastdds.xml
COPY python/ /opt/atd/python/
# entrypoint が動く前にも Fast DDS は loopback を使う。起動時に checkout の設定を適用する。
RUN bash /opt/atd/scripts/configure-dds.sh

# 通常の dev 環境では、固定入口からマウント中の checkout にある実装を呼ぶ。
COPY --chmod=0755 scripts/atd-entrypoint.sh /usr/local/bin/scripts/entrypoint_additions/10-atd-runtime.sh
RUN for command in atd-shell atd-python atd-build atd-vgl atd-web; do \
        ln -s /opt/atd/scripts/atd-dispatch.sh "/usr/local/bin/$command" || exit 1; \
    done \
    && ln -s /opt/atd/scripts/atd.bashrc /etc/atd/bashrc

# entrypoint での export だけでは docker exec へ継承されないため、既定値も記録する。
# ATD 専用 shell ではホストの .bashrc を読み込まず、旧 Cyclone 設定との混在を防ぐ。
ENV ATD_RUNTIME_API=1 \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp \
    FASTDDS_DEFAULT_PROFILES_FILE=/etc/atd/fastdds.xml \
    ROS_AUTOMATIC_DISCOVERY_RANGE=SYSTEM_DEFAULT \
    ROS_STATIC_PEERS="" \
    RMW_FASTRTPS_USE_QOS_FROM_XML=0 \
    CYCLONEDDS_URI="" \
    FASTRTPS_DEFAULT_PROFILES_FILE="" \
    ROS_DISCOVERY_SERVER="" \
    FASTDDS_ENVIRONMENT_FILE="" \
    ROS_LOCALHOST_ONLY="" \
    ROS2_EASY_MODE="" \
    SKIP_DEFAULT_XML=0 \
    BASH_ENV=/etc/atd/dds.env.sh

# 起動時にセンサ・rosbag・車両ノードや bridge は自動実行しない。
